# Django Secret Key (Replace with a strong secret key in production)
SECRET_KEY=replace-with-a-secure-random-secret-key

# Debug mode (Set to False in production)
DEBUG=False

# Allowed hosts (comma-separated list of domains and IPs)
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,127.0.0.1,localhost

# Optional: HTTPS / SSL settings in production (True or False)
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
